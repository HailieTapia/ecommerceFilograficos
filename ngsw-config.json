{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-data",
      "urls": [
        "/api/products/collection/**",
        "/api/reviews/product/**",
        "/api/csrf-token"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "24h",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "auth",
      "urls": [
        "/api/auth/**"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "static-content",
      "urls": [
        "/api/users/profile",        
        "/api/regulatory",           
        "/api/faq/public",           
        "/api/company"             
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30d",              
        "timeout": "5s",
        "strategy": "freshness"       
      }
    }
  ],
  "navigationUrls": [
    "/**"
  ]
}